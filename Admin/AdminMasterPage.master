<%@ Master Language="C#" AutoEventWireup="true"
    CodeFile="AdminMasterPage.master.cs"
    Inherits="Admin_AdminMasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>Admin | CivicConnect</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f4f6fb;
            font-family: 'Segoe UI', sans-serif;
        }

        /* ===== NAVBAR ===== */
        .admin-navbar {
            background: #ffffff;
            padding: 12px 25px;
            border-bottom: 1px solid #e6e6e6;
        }

        .navbar-brand {
            font-weight: 600;
            color: #2c3e50 !important;
            font-size: 18px;
        }

        .navbar-brand i {
            color: #3d5afe;
            margin-right: 6px;
        }

        .nav-link {
            color: #555 !important;
            font-weight: 500;
            margin-right: 15px;
        }

        .nav-link:hover {
            color: #3d5afe !important;
        }

        /* Search Bar */
        .search-box {
            position: relative;
        }

        .search-box input {
            border-radius: 20px;
            padding-left: 35px;
        }

        .search-box i {
            position: absolute;
            top: 10px;
            left: 12px;
            color: #999;
        }

        /* Right Icons */
        .admin-icons i {
            font-size: 18px;
            margin-left: 20px;
            color: #555;
            cursor: pointer;
        }

        .admin-icons i:hover {
            color: #3d5afe;
        }

        .profile-circle {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #3d5afe;
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            margin-left: 15px;
        }

        /* Page Content */
        .page-wrapper {
            padding: 25px;
        }

    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <!-- ===== TOP NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg admin-navbar">

        <!-- LEFT: LOGO -->
        <a class="navbar-brand" href="#">
            <i class="fas fa-landmark"></i> CivicConnect Admin
        </a>

        <!-- TOGGLER -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#adminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- MENU + RIGHT SIDE -->
        <div class="collapse navbar-collapse" id="adminNavbar">

            <!-- CENTER MENU -->
            <ul class="navbar-nav ms-4">
                <li class="nav-item">
                    <a class="nav-link" href="Default.aspx">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="IssueManagment.aspx">
                        Issues
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="AddDepartment.aspx">
                        Departments
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="Analytics.aspx">
                        Analytics
                    </a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link" href="ChnageEmail.aspx">
                        Setting
                    </a>
                </li>
            </ul>

            <!-- RIGHT SIDE -->
            <div class="ms-auto d-flex align-items-center">

                <!-- Search -->
             <%--   <div class="search-box me-3">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search issues, citizens..." />
                </div>--%>

                <!-- Icons -->
                <div class="admin-icons">
                 <%--   <i class="fas fa-bell"></i>--%>
                    <i class="fas fa-power-off" onclick="location.href='../Default3.aspx'"></i>
                </div>

                <!-- Profile -->
                <div class="profile-circle">
                    A
                </div>

            </div>

        </div>
    </nav>

    <!-- ===== PAGE CONTENT ===== -->
    <div class="page-wrapper">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
    </div>

</form>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>